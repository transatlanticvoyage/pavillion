{
  "name": "pavillion",
  "productName": "Pavillion",
  "version": "1.0.0",
  "description": "A multi-sidebar file manager for macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac --dir",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "author": "Kyle Campbell",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.pavillion.app",
    "productName": "Pavillion",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
